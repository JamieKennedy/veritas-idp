{
  "name": "veritas",
  "version": "0.0.0-development",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "restore": "dotnet restore Veritas.slnx && pnpm install --frozen-lockfile",
    "dev": "dotnet run --project src/orchestration/aspire/Veritas.AppHost/Veritas.AppHost.csproj",
    "dev:backend": "dotnet run --project src/orchestration/aspire/Veritas.AppHost/Veritas.AppHost.csproj",
    "dev:admin-ui": "pnpm --filter admin-ui dev",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "dotnet build Veritas.slnx",
    "build:frontend": "pnpm -r --if-present build",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "dotnet test Veritas.slnx",
    "test:frontend": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "pnpm format:backend && pnpm format:repository",
    "format:backend": "dotnet format whitespace Veritas.slnx --no-restore && dotnet format style Veritas.slnx --no-restore --severity warn",
    "format:repository": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,css,json,jsonc,md,yml,yaml}\"",
    "format:check": "pnpm format:check:backend && pnpm format:check:repository",
    "format:check:backend": "dotnet format whitespace Veritas.slnx --verify-no-changes --no-restore && dotnet format style Veritas.slnx --verify-no-changes --no-restore --severity warn",
    "format:check:repository": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,css,json,jsonc,md,yml,yaml}\"",
    "lint": "pnpm lint:backend && pnpm lint:frontend && pnpm lint:docs",
    "lint:backend": "dotnet build Veritas.slnx --no-restore",
    "lint:frontend": "eslint --max-warnings 0 \"src/frontend/**/*.{js,mjs,jsx,ts,tsx}\"",
    "lint:docs": "node scripts/quality/lint-markdown.mjs",
    "lint:workflows": "node scripts/quality/lint-workflows.mjs",
    "lint:fix": "eslint --fix --max-warnings 0 \"src/frontend/**/*.{js,mjs,jsx,ts,tsx}\"",
    "fix": "pnpm format && pnpm lint:fix",
    "check": "pnpm check:structure && pnpm check:generated && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build:backend && pnpm test",
    "check:structure": "node scripts/quality/verify-project-registration.mjs",
    "check:generated": "node scripts/quality/verify-generated.mjs",
    "check:compose": "docker compose --env-file .env.example -f compose.yaml -f compose.local.yaml config --quiet",
    "check:containers": "node scripts/quality/check-containers.mjs",
    "check:pr": "node scripts/quality/validate-pr.mjs",
    "generate:routes": "pnpm -r --if-present generate-routes",
    "release": "semantic-release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "eslint": "10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "markdownlint-cli2": "0.23.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semantic-release": "25.0.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
