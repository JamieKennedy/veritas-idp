# Use an immutable stable or prerelease version, for example 0.2.0-beta.3.
VERITAS_VERSION=0.0.0-development

# The Admin UI is bound to loopback so an external HTTPS reverse proxy can be
# the only public ingress.
VERITAS_BIND_ADDRESS=127.0.0.1
VERITAS_ADMIN_UI_PORT=8080

# Replace these examples with independently generated high-entropy values.
VERITAS_POSTGRES_PASSWORD=replace-with-a-random-database-password
VERITAS_RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password

# This file must contain a generated bootstrap secret and must not be committed.
VERITAS_BOOTSTRAP_SECRET_FILE=./secrets/bootstrap-secret.txt
