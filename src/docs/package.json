{
  "name": "veritas-docs",
  "version": "0.0.0-development",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "astro check",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "astro": "7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.80.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "pagefind": "1.6.0",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.2"
  }
}
