---
import type { NavigationSection } from '@/lib/documentation'
import { withBase } from '@/lib/site'

interface Props {
    currentId: string
    navigation: Array<NavigationSection>
}

const { currentId, navigation } = Astro.props
---

<nav class="docs-sidebar" aria-label="Documentation">
    {navigation.map((section) => (
        <section>
            <h2>{section.label}</h2>
            <ul>
                {section.items.map((item) => (
                    <li>
                        <a href={withBase(item.href)} aria-current={item.id === currentId ? 'page' : undefined}>
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</nav>
