---
import { getCollection, render } from 'astro:content'

import DocsLayout from '@/layouts/DocsLayout.astro'

const entries = await getCollection('docs')
const entry = entries.find((candidate) => candidate.id === 'index')

if (!entry) {
    throw new Error('docs/README.md must exist as the documentation overview.')
}

const { Content, headings } = await render(entry)
---

<DocsLayout entry={entry} entries={entries} headings={headings}>
    <Content />
</DocsLayout>
